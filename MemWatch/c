#include <stdio.h>
#include <windows.h>

typedef struct {
    unsigned long long total_mem; // Use long long for large capacities
    unsigned long long free_mem;
    double cpu_usage;
} SysSnap;

void get_memory_info(SysSnap *snap) {
    MEMORYSTATUSEX statex;
    statex.dwLength = sizeof(statex);

    if (GlobalMemoryStatusEx(&statex)) {
        // Converting bytes to KB for compatibility with your structure
        snap->total_mem = statex.ullTotalPhys / 1024;
        snap->free_mem = statex.ullAvailPhys / 1024;
    }
    else {
        fprintf(stderr, "Error retrieving memory data.\n");
    }
   int main() {
    SysSnap current_stats = {0};
    
    printf("--- LittleWatcher v1.0 (Windows Edition) ---\n");
    get_memory_info(&current_stats);
    
    printf("Total RAM: %llu MB\n", current_stats.total_mem / 1024);
    printf("Available RAM: %llu MB\n", current_stats.free_mem / 1024);
    
    return 0;
}
}
